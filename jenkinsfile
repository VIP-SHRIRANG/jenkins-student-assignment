pipeline {
agent any
stages {
stage('Build') {
steps {
echo 'Compiling application...'
                bat '''
                    if not exist Hello.java (
                        echo ERROR: Main.java is missing!
                        exit /b 1
                    )

                    javac Hello.java
                '''
}
}
stage('Test') {
steps {
echo 'Running unit tests...'
}
}
stage('Package') {
steps {
// Write code here to generate build-info.txt
bat 'echo "Build executed on $(date)" > build-info.txt'
}
}
}
post {
success {
echo 'Build successful! Ready for release.'
}
}
}